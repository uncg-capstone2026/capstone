// This Is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  Top
  Bottoms
  Outerwear
  Shoes
  Accessory
  OnePiece
  Sets
}

enum NotificationType {
  OutfitReminder
  WeatherAlert
  EventReminder
  System
}

enum Fit {
  Fitted
  Slim
  Regular
  Loose
  Oversized
}

enum OutfitSlot {
  top
  bottom
  shoes
  accessory
  outerwear
  onepiece
}

model User {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  passwordHash   String
  displayName    String?
  phone          String?        @unique
  marketingOptIn Boolean        @default(false)
  timeZone       String         @default("America/New_York") // IANA name, for "today" and wear periods
  createdAt      DateTime       @default(now())
  items          Item[]
  photos         TryOnPhoto[]
  collections    Collection[]
  outfits        Outfit[]
  notifications  Notification[]
}

model TryOnPhoto {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  imageKey   String // S3 key
  isPrimary  Boolean  @default(false)
  capturedAt DateTime @default(now())
}

model Item {
  id                     String                      @id @default(uuid())
  userId                 String
  user                   User                        @relation(fields: [userId], references: [id])
  name                   String                      @default("New item")
  category               Category?
  type                   String? // Javier's field, e.g. "t-shirt", "jeans", "sneakers"
  cut                    String? // Emma's field, e.g. "crew neck", "sweater", "jeans" — may overlap with type, revisit with team
  colorHex               String[] // 1-3 values
  pattern                String?
  material               String?
  season                 String?
  formality              String?
  fit                    Fit?
  isFavorite             Boolean                     @default(false)
  imageKey               String
  cutoutKey              String?
  sourceURL              String?
  embedding              Unsupported("vector(768)")?
  timesWorn              Int                         @default(0)
  timesWornThisMonth     Int                         @default(0) // within the current 30-day period
  wearPeriodStart        DateTime                    @default(now()) // start of the current 30-day period
  excludeFromSuggestions Boolean                     @default(false) // never used in outfit suggestions
  createdAt              DateTime                    @default(now())
  outfitItems            OutfitItem[]
}

model Collection {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime           @default(now())
  outfits   CollectionOutfit[]
}

// An outfit saved in a collection. Removed automatically when either is deleted.
model CollectionOutfit {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  outfitId     String
  outfit       Outfit     @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@id([collectionId, outfitId])
  @@index([outfitId])
}

model Outfit {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  name            String
  isFavorite      Boolean            @default(false)
  timesWorn       Int                @default(0)
  lastWorn        DateTime?
  createdAt       DateTime           @default(now())
  items           OutfitItem[]
  calendarEntries CalendarEntry[]
  collections     CollectionOutfit[]
}

// One piece of an outfit. Removed automatically when its outfit or its item is deleted.
model OutfitItem {
  id       String     @id @default(uuid())
  outfitId String
  outfit   Outfit     @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  slot     OutfitSlot
  zIndex   Int

  @@index([itemId])
}

// A planned (or past) day for an outfit. Deleted along with its outfit.
model CalendarEntry {
  id             String         @id @default(uuid())
  outfitId       String
  outfit         Outfit         @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  date           DateTime
  eventName      String?
  weatherSummary String?
  tempHigh       Int?
  wornCountedAt  DateTime? // set once this entry's wear has been added to the counts
  createdAt      DateTime       @default(now())
  notifications  Notification[]

  @@index([wornCountedAt, date])
}

model Notification {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarEntryId String?
  calendarEntry   CalendarEntry?   @relation(fields: [calendarEntryId], references: [id], onDelete: Cascade)
  type            NotificationType
  title           String
  body            String?
  scheduledFor    DateTime // when it should be shown/sent
  sentAt          DateTime? // null until it's actually sent
  readAt          DateTime? // null until the user opens it
  createdAt       DateTime         @default(now())

  @@index([userId, scheduledFor]) // "my notifications, in order"
  @@index([scheduledFor, sentAt]) // "which notifications are due and not sent yet"
}