// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  Top
  Bottoms
  Outerwear
  Shoes
  Accessory
  OnePiece
  Sets
}

enum NotificationType {
  OutfitReminder
  WeatherAlert
  EventReminder
  System
}

enum Fit {
  Fitted
  Slim
  Regular
  Loose
  Oversized
}

enum OutfitSessionStatus {
  active
  completed
  abandoned
}

enum OutfitTurnRoute {
  initial
  reroll
  swap
  refine
  restart
}

enum OutfitTurnStatus {
  pending
  rejected
  accepted
  failed
}

enum OutfitSlot {
  top
  bottom
  shoes
  accessory
  outerwear
  onepiece
}

enum StyleFeedbackKind {
  Accepted
  Rejected
}

model User {
  id                   String          @id @default(uuid())
  name                 String
  email                String          @unique
  passwordHash         String
  displayName          String?
  phone                String?         @unique
  marketingOptIn       Boolean         @default(false)
  timeZone             String          @default("America/New_York") // IANA name, for "today" and wear periods
  notificationsEnabled Boolean         @default(true) // the in-app switch for reminders
  createdAt            DateTime        @default(now())
  items                Item[]
  photos               TryOnPhoto[]
  collections          Collection[]
  outfits              Outfit[]
  notifications        Notification[]
  styleFeedback        StyleFeedback[]
  outfitSessions       OutfitSession[]
  pushTokens           PushToken[]
}

model TryOnPhoto {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  imageKey   String // S3 key
  isPrimary  Boolean  @default(false)
  capturedAt DateTime @default(now())
}

model Item {
  id                     String                      @id @default(uuid())
  userId                 String
  user                   User                        @relation(fields: [userId], references: [id])
  name                   String                      @default("New item")
  category               Category?
  type                   String? // Javier's field, e.g. "t-shirt", "jeans", "sneakers"
  cut                    String? // Emma's field, e.g. "crew neck", "sweater", "jeans" — may overlap with type, revisit with team
  colorHex               String[] // 1-3 values
  pattern                String?
  material               String?
  season                 String?
  formality              String?
  fit                    Fit?
  isFavorite             Boolean                     @default(false)
  imageKey               String
  cutoutKey              String?
  sourceURL              String?
  embedding              Unsupported("vector(768)")?
  timesWorn              Int                         @default(0)
  timesWornThisMonth     Int                         @default(0) // within the current 30-day period
  wearPeriodStart        DateTime                    @default(now()) // start of the current 30-day period
  excludeFromSuggestions Boolean                     @default(false) // never used in outfit suggestions
  createdAt              DateTime                    @default(now())
  outfitItems            OutfitItem[]
}

model Collection {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime           @default(now())
  outfits   CollectionOutfit[]
}

// An outfit saved in a collection. Removed automatically when either is deleted.
model CollectionOutfit {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  outfitId     String
  outfit       Outfit     @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@id([collectionId, outfitId])
  @@index([outfitId])
}

model Outfit {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  name            String
  isFavorite      Boolean            @default(false)
  timesWorn       Int                @default(0)
  lastWorn        DateTime?
  createdAt       DateTime           @default(now())
  items           OutfitItem[]
  calendarEntries CalendarEntry[]
  collections     CollectionOutfit[]
}

// One piece of an outfit. Removed automatically when its outfit or its item is deleted.
model OutfitItem {
  id       String     @id @default(uuid())
  outfitId String
  outfit   Outfit     @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  slot     OutfitSlot
  zIndex   Int

  @@index([itemId])
}

// A planned (or past) day for an outfit. Deleted along with its outfit.
model CalendarEntry {
  id             String         @id @default(uuid())
  outfitId       String
  outfit         Outfit         @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  date           DateTime
  eventName      String?
  weatherSummary String?
  tempHigh       Int?
  wornCountedAt  DateTime? // set once this entry's wear has been added to the counts
  createdAt      DateTime       @default(now())
  notifications  Notification[]

  @@index([wornCountedAt, date])
}

model Notification {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarEntryId String?
  calendarEntry   CalendarEntry?   @relation(fields: [calendarEntryId], references: [id], onDelete: Cascade)
  type            NotificationType
  title           String
  body            String?
  scheduledFor    DateTime // when it should be shown/sent
  sentAt          DateTime? // null until it's actually sent
  readAt          DateTime? // null until the user opens it
  createdAt       DateTime         @default(now())

  @@index([userId, scheduledFor]) // "my notifications, in order"
  @@index([scheduledFor, sentAt]) // "which notifications are due and not sent yet"
}

// "Looks right" and "Not for me" on Stylist suggestions, for learning the user's style.
model StyleFeedback {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         StyleFeedbackKind
  suggestionId String
  itemIds      String[]
  outfitId     String? // the saved outfit, for Accepted
  feedback     String? // "What would you rather wear?", for Rejected
  createdAt    DateTime          @default(now())

  @@index([userId, createdAt])
}

// One Stylist conversation: the first request and every outfit shown after it.
// See ai/repromptimplementation.md.
model OutfitSession {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalPrompt        String
  date                  String? // 'YYYY-MM-DD' the outfit is for
  weather               Json? // forecast snapshot from turn 1
  status                OutfitSessionStatus @default(active)
  acceptedTurnId        String?             @unique
  acceptedTurn          OutfitTurn?         @relation("AcceptedTurn", fields: [acceptedTurnId], references: [id])
  queuedOutfits         Json                @default("[]") // [{ itemIds, name, reasons }] extras for reroll
  bannedItemIds         String[] // items the user asked to replace; never suggested again in this session
  historySummary        String? // turns older than the last 5, compressed
  summarizedThroughTurn Int                 @default(0)
  memoryProcessed       Boolean             @default(false) // for the later memory job
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  turns                 OutfitTurn[]        @relation("SessionTurns")

  @@index([userId, updatedAt])
}

// One outfit shown in a session (or a failed attempt at one).
model OutfitTurn {
  id            String           @id @default(uuid())
  sessionId     String
  session       OutfitSession    @relation("SessionTurns", fields: [sessionId], references: [id], onDelete: Cascade)
  turnNumber    Int
  userMessage   String // the original prompt (turn 1), the feedback, or '' for a plain reroll
  route         OutfitTurnRoute
  requirements  Json // { items: [{ type, semantic_query }] }
  candidates    Json // { [type]: [{ itemId, score }] }, closest first, up to 10 per type
  sentItemIds   String[]
  chosenItemIds String[]
  name          String?
  reasons       String[]
  status        OutfitTurnStatus @default(pending)
  error         String? // why a failed turn failed
  createdAt     DateTime         @default(now())
  acceptedIn    OutfitSession?   @relation("AcceptedTurn")

  @@unique([sessionId, turnNumber])
}

// One Expo push token per device. A user can have several devices.
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique // ExponentPushToken[...]
  createdAt DateTime @default(now())

  @@index([userId])
}
