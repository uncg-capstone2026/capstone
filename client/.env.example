# Copy to .env.local (gitignored) and fill in. Restart `npx expo start` after changing.
#
# Base URL of the Next.js backend, e.g. http://192.168.1.20:3000 when testing on a device.
# Leave empty to run with local placeholder services (no network calls).
#
# Never put AWS keys in the app: EXPO_PUBLIC_* values ship inside the bundle.
# The backend presigns S3 uploads and the app PUTs straight to the presigned URL.
EXPO_PUBLIC_API_URL=
